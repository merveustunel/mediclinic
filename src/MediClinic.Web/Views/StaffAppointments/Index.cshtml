@model StaffAppointmentsModel
@using MediClinic.Application
@using System.Globalization
@{ ViewData["Title"] = Ui.Text("Personel randevuları"); }
<header class="appointments-heading"><div><p class="eyebrow">@Ui.Text("RANDEVU YÖNETİMİ")</p><h1>@Ui.Text("Bölüm randevuları")</h1><p class="field-hint">@Ui.Text("Bölümünüzdeki talepleri inceleyin ve randevuları yönetin.")</p></div><a class="button button-secondary" asp-controller="Dashboard" asp-action="Staff">@Ui.Text("Personel paneline dön")</a></header>
<nav class="appointment-filters" aria-label="@Ui.Text("Randevu durumu filtreleri")">
@foreach (var filter in PatientAppointmentsModel.Filters)
{
    <a class="button button-secondary" asp-action="Index" asp-route-status="@filter.Value" asp-route-date="@Model.Date?.ToString("yyyy-MM-dd")" aria-current="@((Model.Status ?? "") == filter.Value ? "page" : null)">@Ui.Text(filter.Label)</a>
}
</nav>
<form method="get" class="staff-date-filter">
    <input type="hidden" name="status" value="@Model.Status" />
    <div><label for="date">@Ui.Text("Randevu tarihi")</label><input id="date" type="date" name="date" value="@Model.Date?.ToString("yyyy-MM-dd")" /></div>
    <button type="submit">@Ui.Text("Tarihe göre filtrele")</button><a asp-action="Index">@Ui.Text("Filtreleri temizle")</a>
</form>
<p class="field-hint">@Ui.Format("{0} randevu gösteriliyor. Saatler İstanbul saatine göredir.", Model.Appointments.Count)</p>
@if (Model.Appointments.Count == 0)
{
    <section class="empty-state"><h2>@Ui.Text("Randevu bulunamadı")</h2><p>@Ui.Text("Bölümünüzde seçilen filtrelere uygun randevu bulunmuyor. Diğer durumları veya tarihleri kontrol edebilirsiniz.")</p><a class="button button-secondary" asp-action="Index">@Ui.Text("Tüm randevuları görüntüle")</a></section>
}
else
{
    <ul class="staff-appointment-list">
    @foreach (var entry in Model.Appointments)
    {
        var item = entry.Appointment;
        <li><div><h2 data-user-content>@entry.Patient</h2><p>@item.Doctor · @item.Service</p><p data-user-content>@item.Branch</p><time datetime="@item.StartsAt.ToString("O")">@Scheduling.Local(item.StartsAt).ToString("dd MMMM yyyy, HH:mm", CultureInfo.CurrentCulture)</time></div><partial name="_StatusBadge" model="item.Status" /><a class="button button-secondary" asp-action="Details" asp-route-id="@item.Id">@Ui.Text("Detayları görüntüle")<span class="visually-hidden">: @entry.Patient</span></a></li>
    }
    </ul>
}
