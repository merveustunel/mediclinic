@model IReadOnlyList<MediClinic.Application.AppointmentSummary>
@{ var staff = ViewContext.RouteData.Values["controller"]?.ToString() == "StaffAppointments"; }
<h1>@(staff ? Ui.Text("Bölüm randevuları") : Ui.Text("Randevularım"))</h1>
@if (!staff) { <a asp-action="Book">@Ui.Text("Randevu oluştur")</a> }
<p>@Ui.Text("Saatler Europe/Istanbul saat diliminde gösterilir.")</p>
<div class="table-scroll" role="region" aria-label="@Ui.Text("Randevu listesi")" tabindex="0"><table>
    <thead><tr><th scope="col">@Ui.Text("Hizmet")</th><th scope="col">@Ui.Text("Doktor")</th><th scope="col">@Ui.Text("Şube")</th><th scope="col">@Ui.Text("Başlangıç")</th><th scope="col">@Ui.Text("Durum")</th><th scope="col">@Ui.Text("İşlem")</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr><td data-user-content>@item.Service</td><td data-user-content>@item.Doctor</td><td data-user-content>@item.Branch</td><td><time datetime="@item.StartsAt.ToString("O")">@Ui.Date(MediClinic.Application.Scheduling.Local(item.StartsAt))</time></td><td><partial name="_StatusBadge" model="item.Status" /></td><td><a asp-action="Details" asp-route-id="@item.Id">@Ui.Text("Detaylar")</a></td></tr>
    }
    </tbody>
</table></div>
@if (Model.Count == 0) { <p class="empty-state">@Ui.Text("Görüntülenecek randevu bulunmuyor.")</p> }
