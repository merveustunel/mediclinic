@model IReadOnlyList<MediClinic.Application.AppointmentSummary>
@{ var staff = ViewContext.RouteData.Values["controller"]?.ToString() == "StaffAppointments"; }
<h1>@(staff ? "Bölüm randevuları" : "Randevularım")</h1>
@if (!staff) { <a asp-action="Book">Randevu oluştur</a> }
<p>Saatler Europe/Istanbul saat diliminde gösterilir.</p>
<div class="table-scroll" role="region" aria-label="Randevu listesi" tabindex="0"><table>
    <thead><tr><th scope="col">Hizmet</th><th scope="col">Doktor</th><th scope="col">Şube</th><th scope="col">Başlangıç</th><th scope="col">Durum</th><th scope="col">İşlem</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr><td>@item.Service</td><td>@item.Doctor</td><td>@item.Branch</td><td>@MediClinic.Application.Scheduling.Local(item.StartsAt).ToString("yyyy-MM-dd HH:mm")</td><td><partial name="_StatusBadge" model="item.Status" /></td><td><a asp-action="Details" asp-route-id="@item.Id">Detaylar</a></td></tr>
    }
    </tbody>
</table></div>
@if (Model.Count == 0) { <p class="empty-state">Görüntülenecek randevu bulunmuyor.</p> }
