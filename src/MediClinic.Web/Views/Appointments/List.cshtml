@model IReadOnlyList<MediClinic.Application.AppointmentSummary>
@{ var staff = ViewContext.RouteData.Values["controller"]?.ToString() == "StaffAppointments"; }
<h1>@(staff ? "Department appointments" : "My appointments")</h1>
@if (!staff) { <a asp-action="Book">Book an appointment</a> }
<p>Times shown in Europe/Istanbul.</p>
<table>
    <thead><tr><th>Service</th><th>Doctor</th><th>Branch</th><th>Local start</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr><td>@item.Service</td><td>@item.Doctor</td><td>@item.Branch</td><td>@MediClinic.Application.Scheduling.Local(item.StartsAt).ToString("yyyy-MM-dd HH:mm")</td><td>@item.Status</td><td><a asp-action="Details" asp-route-id="@item.Id">Details</a></td></tr>
    }
    </tbody>
</table>
@if (Model.Count == 0) { <p>No appointments in your scope.</p> }
