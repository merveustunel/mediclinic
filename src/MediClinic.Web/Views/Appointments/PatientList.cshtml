@model MediClinic.Web.Models.PatientAppointmentsModel
@using MediClinic.Application
@using System.Globalization
@{ ViewData["Title"] = Ui.Text("Randevularım"); }
<header class="appointments-heading">
    <div>
        <p class="eyebrow">@Ui.Text("RANDEVULARIM")</p>
        <h1>@Ui.Text("Randevularınızı takip edin")</h1>
        <p class="field-hint">@Ui.Text("Geçmiş ve yaklaşan randevularınızı inceleyin, durumlarını kolayca takip edin.")</p>
    </div>
    <a class="button" asp-action="Book">@Ui.Text("Yeni randevu oluştur")</a>
</header>
<nav class="appointment-filters" aria-label="@Ui.Text("Randevu durumu filtreleri")">
    @foreach (var filter in MediClinic.Web.Models.PatientAppointmentsModel.Filters)
    {
        <a class="button button-secondary" asp-action="Index" asp-route-status="@(filter.Value == "" ? null : filter.Value)"
           aria-current="@((Model.Status ?? "") == filter.Value ? "page" : null)">@Ui.Text(filter.Label)</a>
    }
</nav>
<p class="field-hint">@Ui.Format("{0} randevu gösteriliyor. Saatler İstanbul saatine göredir.", Model.Appointments.Count)</p>
@if (Model.Appointments.Count == 0)
{
    <section class="empty-state" aria-labelledby="appointments-empty-title">
        @if (Model.TotalCount == 0)
        {
            <h2 id="appointments-empty-title">@Ui.Text("Henüz randevunuz bulunmuyor")</h2>
            <p>@Ui.Text("Sağlık planınıza ilk randevunuzu oluşturarak başlayabilirsiniz.")</p>
            <a class="button" asp-action="Book">@Ui.Text("Yeni randevu oluştur")</a>
        }
        else
        {
            <h2 id="appointments-empty-title">@Ui.Text("Bu durumda randevunuz bulunmuyor")</h2>
            <p>@Ui.Text("Diğer durumları seçebilir veya tüm randevularınızı görüntüleyebilirsiniz.")</p>
            <a class="button button-secondary" asp-action="Index">@Ui.Text("Tüm randevuları görüntüle")</a>
        }
    </section>
}
else
{
    <div class="patient-appointments">
        <table class="appointments-table">
            <caption class="visually-hidden">@Ui.Text("Randevularınız, başlangıç tarihine göre yeniden eskiye")</caption>
            <thead><tr><th scope="col">@Ui.Text("Doktor")</th><th scope="col">@Ui.Text("Hizmet")</th><th scope="col">@Ui.Text("Şube")</th><th scope="col">@Ui.Text("Tarih ve saat")</th><th scope="col">@Ui.Text("Durum")</th><th scope="col">@Ui.Text("İşlem")</th></tr></thead>
            <tbody>
            @foreach (var item in Model.Appointments)
            {
                <tr>
                    <td><span class="appointment-field-label" aria-hidden="true">@Ui.Text("Doktor")</span>@item.Doctor</td>
                    <td><span class="appointment-field-label" aria-hidden="true">@Ui.Text("Hizmet")</span>@item.Service</td>
                    <td><span class="appointment-field-label" aria-hidden="true">@Ui.Text("Şube")</span>@item.Branch</td>
                    <td><span class="appointment-field-label" aria-hidden="true">@Ui.Text("Tarih ve saat")</span><time datetime="@item.StartsAt.ToString("O", CultureInfo.InvariantCulture)">@Scheduling.Local(item.StartsAt).ToString("dd MMMM yyyy, HH:mm", CultureInfo.CurrentCulture)</time></td>
                    <td><span class="appointment-field-label" aria-hidden="true">@Ui.Text("Durum")</span><partial name="_StatusBadge" model="item.Status" /></td>
                    <td><a asp-action="Details" asp-route-id="@item.Id">@Ui.Text("Detayları görüntüle")<span class="visually-hidden">: @item.Doctor, @Scheduling.Local(item.StartsAt).ToString("dd MMMM yyyy, HH:mm", CultureInfo.CurrentCulture)</span></a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
