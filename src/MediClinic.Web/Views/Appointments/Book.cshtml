@model MediClinic.Web.Models.BookingModel
<h1>Randevu oluştur</h1>
<p>Tüm saatler Europe/Istanbul saat dilimindedir. Klinik / şube / bölüm / doktor / hizmet seçiminizi yapın ve uygun bir saat seçin. Yeni talepler inceleme için beklemeye alınır.</p>
<div asp-validation-summary="All" role="alert"></div>
<form method="get" asp-action="Book" id="selection">
    <label for="option">Klinik / şube / bölüm / doktor / hizmet</label>
    <select id="option" required>
        <option value="">Bir seçenek seçin</option>
        @foreach (var option in Model.Options)
        {
            <option value="@option.ServiceId" data-clinic="@option.ClinicId" data-branch="@option.BranchId" data-department="@option.DepartmentId" data-doctor="@option.DoctorId" selected="@(option.DoctorId == Model.DoctorId && option.ServiceId == Model.ServiceId)">@option.Clinic / @option.Branch / @option.Department / @option.Doctor / @option.Service (@option.Duration.TotalMinutes min)</option>
        }
    </select>
    <input type="hidden" name="ClinicId" value="@Model.ClinicId" /><input type="hidden" name="BranchId" value="@Model.BranchId" />
    <input type="hidden" name="DepartmentId" value="@Model.DepartmentId" /><input type="hidden" name="DoctorId" value="@Model.DoctorId" /><input type="hidden" name="ServiceId" value="@Model.ServiceId" />
    <label asp-for="Date">Randevu tarihi</label><input asp-for="Date" type="date" required />
    <button type="submit">Uygun saatleri göster</button>
</form>
@if (Model.Slots.Count > 0)
{
    <form asp-action="Book" method="post">
        <input asp-for="ClinicId" type="hidden" /><input asp-for="BranchId" type="hidden" /><input asp-for="DepartmentId" type="hidden" />
        <input asp-for="DoctorId" type="hidden" /><input asp-for="ServiceId" type="hidden" /><input asp-for="Date" type="hidden" />
        <label asp-for="LocalStart">Uygun randevu saati</label>
        <select asp-for="LocalStart" required>
            @foreach (var slot in Model.Slots) { <option value="@slot.ToString("yyyy-MM-ddTHH:mm:ss")">@slot.ToString("yyyy-MM-dd HH:mm")</option> }
        </select>
        <button type="submit">Randevu talep et</button>
    </form>
}
else if (Model.DoctorId != Guid.Empty) { <p>Uygun saat yüklenmedi. Bir tarih seçerek uygun saatleri görüntüleyin.</p> }
<a asp-action="Index">Randevularım</a>
<script>
document.getElementById('selection').addEventListener('submit', function () {
    const option = document.getElementById('option').selectedOptions[0];
    for (const key of ['Clinic', 'Branch', 'Department', 'Doctor']) this.elements[key + 'Id'].value = option.dataset[key.toLowerCase()];
    this.elements.ServiceId.value = option.value;
});
</script>
