@model MediClinic.Web.Models.BookingModel
@using System.Globalization
@{ var tr = CultureInfo.CurrentCulture; ViewData["Title"] = Ui.Text("Randevu oluştur"); }
<div class="appointments-heading"><div><p class="eyebrow">@Ui.Text("SAĞLIĞINIZ İÇİN BİR ADIM")</p><h1>@Ui.Text("Randevu oluştur")</h1><p>@Ui.Text("Size uygun hizmeti ve zamanı seçin. Tüm saatler İstanbul saat dilimindedir.")</p></div><a asp-action="Index">@Ui.Text("Randevularım")</a></div>
<ol class="booking-steps" aria-label="@Ui.Text("Randevu aşamaları")">
@foreach (var step in new[] { (1, Ui.Text("Hizmet seçimi")), (2, Ui.Text("Tarih ve saat")), (3, Ui.Text("Kontrol ve talep")) })
{ <li aria-current="@(Model.Stage == step.Item1 ? "step" : null)"><span>@step.Item1</span> @step.Item2</li> }
</ol>
<div asp-validation-summary="All" role="alert"></div>
<p class="alert">@Ui.Text("Yeni randevular") <strong>@Ui.Text("Beklemede")</strong> @Ui.Text("durumunda oluşturulur. Talebiniz personel tarafından incelenir; gönderim kesin onay anlamına gelmez.")</p>
@if (Model.Stage == 1)
{
<section class="card"><h2>@Ui.Text("1. Hizmetinizi seçin")</h2><p id="selection-help">@Ui.Text("Önce kliniği seçip “Seçenekleri güncelle” düğmesine basın. Ardından sırayla şube, bölüm, doktor ve hizmet seçin. Üst seçimi değiştirirseniz alt seçimleri yeniden yapın.")</p>
@if (Model.Options.Count == 0) { <p class="empty-state">@Ui.Text("Şu anda randevu alınabilecek hizmet bulunmuyor. Lütfen daha sonra tekrar deneyin.")</p> }
<form method="get" asp-action="Book" aria-describedby="selection-help" data-booking-selection>
<p data-booking-status role="status" aria-live="polite"></p>
<input type="hidden" name="Date" value="@Model.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"/>
<div class="booking-fields">
@{ var candidates = Model.Options; var fields = new[] { ("ClinicId", Ui.Text("Klinik"), Model.ClinicId), ("BranchId", Ui.Text("Şube"), Model.BranchId), ("DepartmentId", Ui.Text("Bölüm"), Model.DepartmentId), ("DoctorId", Ui.Text("Doktor"), Model.DoctorId), ("ServiceId", Ui.Text("Hizmet"), Model.ServiceId) }; }
@for (var i = 0; i < fields.Length; i++)
{
    var field = fields[i];
    var choices = candidates.Select(x => i switch { 0 => (x.ClinicId, x.Clinic), 1 => (x.BranchId, x.Branch), 2 => (x.DepartmentId, x.Department), 3 => (x.DoctorId, x.Doctor), _ => (x.ServiceId, Ui.Format("{0} - {1} dakika - {2}", x.Service, x.Duration.TotalMinutes, Ui.Money(x.Price))) }).Distinct().OrderBy(x => x.Item2, StringComparer.Create(tr, false)).ToArray();
    <div><label for="@field.Item1">@field.Item2</label><select id="@field.Item1" name="@field.Item1" disabled="@(choices.Length == 0)"><option value="@Guid.Empty">@(choices.Length == 0 ? Ui.Text("Önce üst seçimi tamamlayın") : Ui.Text("Seçin"))</option>
    @foreach (var choice in choices) {
        var serviceOption = i == 4 ? Model.Options.FirstOrDefault(o => o.ServiceId == choice.Item1) : null;
        if (serviceOption is null) { <option value="@choice.Item1" selected="@(choice.Item1 == field.Item3)" data-user-content>@choice.Item2</option> }
        else { <option value="@choice.Item1" selected="@(choice.Item1 == field.Item3)" data-service-name="@serviceOption.Service" data-service-price="@serviceOption.Price.ToString(CultureInfo.InvariantCulture)" data-service-minutes="@serviceOption.Duration.TotalMinutes.ToString(CultureInfo.InvariantCulture)">@choice.Item2</option> }
    }
    </select></div>
    candidates = candidates.Where(x => (i switch { 0 => x.ClinicId, 1 => x.BranchId, 2 => x.DepartmentId, 3 => x.DoctorId, _ => x.ServiceId }) == field.Item3).ToArray();
}
</div>
<div class="booking-actions"><button name="Stage" value="1" class="button-secondary" data-booking-update>@Ui.Text("Seçenekleri güncelle")</button><button name="Stage" value="2" data-booking-continue>@Ui.Text("Tarih ve saate devam et")</button></div>
</form></section>
<script src="~/js/booking.js" asp-append-version="true" defer></script>
}
else
{
var selected = Model.Selection!;
<section class="card"><h2>@(Model.Stage == 2 ? Ui.Text("2. Tarih ve saat seçin") : Ui.Text("3. Talebinizi kontrol edin"))</h2>
<p>@Ui.Text("Ücret:") <span data-money="@selected.Price.ToString(CultureInfo.InvariantCulture)">@Ui.Money(selected.Price)</span></p>
<dl class="booking-summary">
<div><dt>@Ui.Text("Klinik")</dt><dd data-user-content>@selected.Clinic</dd></div><div><dt>@Ui.Text("Şube")</dt><dd data-user-content>@selected.Branch</dd></div><div><dt>@Ui.Text("Bölüm")</dt><dd data-user-content>@selected.Department</dd></div><div><dt>@Ui.Text("Doktor")</dt><dd data-user-content>@selected.Doctor</dd></div><div><dt>@Ui.Text("Hizmet")</dt><dd data-user-content>@selected.Service</dd></div><div><dt>@Ui.Text("Süre")</dt><dd>@selected.Duration.TotalMinutes.ToString(tr) @Ui.Text("dakika")</dd></div>
@if (Model.Stage == 3) { <div><dt>@Ui.Text("Tarih")</dt><dd><time datetime="@Model.LocalStart!.Value.ToString("yyyy-MM-dd")" data-date-only="true">@Model.LocalStart!.Value.ToString("dd MMMM yyyy, dddd", tr)</time></dd></div><div><dt>@Ui.Text("Saat")</dt><dd>@Model.LocalStart!.Value.ToString("HH:mm", tr)</dd></div> }
</dl>
<form asp-action="Book" method="get">
<input type="hidden" name="ClinicId" value="@Model.ClinicId"/><input type="hidden" name="BranchId" value="@Model.BranchId"/><input type="hidden" name="DepartmentId" value="@Model.DepartmentId"/><input type="hidden" name="DoctorId" value="@Model.DoctorId"/><input type="hidden" name="ServiceId" value="@Model.ServiceId"/>
@if (Model.Stage == 2)
{
<label for="booking-date">@Ui.Text("Randevu tarihi")</label><input id="booking-date" name="Date" type="date" required value="@Model.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"/>
<button name="Stage" value="2" class="button-secondary">@Ui.Text("Uygun saatleri göster")</button>
<p><time datetime="@Model.Date.ToString("yyyy-MM-dd")" data-date-only="true">@Model.Date.ToString("dd MMMM yyyy, dddd", tr)</time></p>
@if (Model.Slots.Count == 0) { <p class="empty-state" role="status">@(selected.ClosedDays?.Contains(Model.Date.DayOfWeek) == true ? Ui.Text("Şube bu tarihte kapalı. Başka bir tarih seçin.") : Ui.Text("Bu tarihte uygun saat bulunmuyor. Başka bir tarih seçin."))</p> }
@if (Model.TimeCards.Count > 0) {
<fieldset class="booking-times"><legend>@Ui.Text("Randevu saatleri: uygun bir saat seçin")</legend><div class="booking-slot-grid">
@foreach (var card in Model.TimeCards) {
    <label class="booking-slot @(card.IsPast ? "booking-slot-past" : null)"><input type="radio" name="LocalStart" value="@card.LocalStart.ToString("yyyy-MM-ddTHH:mm:ss", CultureInfo.InvariantCulture)" disabled="@card.IsPast" checked="@(!card.IsPast && card.LocalStart == Model.LocalStart)"/><span>@card.LocalStart.ToString("HH:mm", tr)@if (card.IsPast) { <small class="booking-slot-note">@Ui.Text("Geçmiş saat")</small> }</span></label>
}
</div></fieldset>
}
@if (Model.Slots.Count > 0) { <button name="Stage" value="3">@Ui.Text("Talep özetini gör")</button> }
}
else
{
<input type="hidden" name="Date" value="@Model.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"/>
<input type="hidden" name="LocalStart" value="@Model.LocalStart!.Value.ToString("yyyy-MM-ddTHH:mm:ss", CultureInfo.InvariantCulture)"/>
@Html.AntiForgeryToken()
<button type="submit" formmethod="post">@Ui.Text("Randevu talebini gönder")</button>
<button name="Stage" value="2" class="button-secondary">@Ui.Text("Tarih ve saati değiştir")</button>
}
<button name="Stage" value="1" class="button-secondary" formnovalidate>@Ui.Text("Hizmet seçimini değiştir")</button>
</form></section>
}
