@model MediClinic.Web.Models.BookingModel
@using System.Globalization
@{ var tr = CultureInfo.GetCultureInfo("tr-TR"); ViewData["Title"] = "Randevu oluştur"; }
<div class="appointments-heading"><div><p class="eyebrow">SAĞLIĞINIZ İÇİN BİR ADIM</p><h1>Randevu oluştur</h1><p>Size uygun hizmeti ve zamanı seçin. Tüm saatler Europe/Istanbul saat dilimindedir.</p></div><a asp-action="Index">Randevularım</a></div>
<ol class="booking-steps" aria-label="Randevu aşamaları">
@foreach (var step in new[] { (1, "Hizmet seçimi"), (2, "Tarih ve saat"), (3, "Kontrol ve talep") })
{ <li aria-current="@(Model.Stage == step.Item1 ? "step" : null)"><span>@step.Item1</span> @step.Item2</li> }
</ol>
<div asp-validation-summary="All" role="alert"></div>
<p class="alert">Yeni randevular <strong>Beklemede</strong> durumunda oluşturulur. Talebiniz personel tarafından incelenir; gönderim kesin onay anlamına gelmez.</p>
@if (Model.Stage == 1)
{
<section class="card"><h2>1. Hizmetinizi seçin</h2><p id="selection-help">Önce kliniği seçip “Seçenekleri güncelle” düğmesine basın. Ardından sırayla şube, bölüm, doktor ve hizmet seçin. Üst seçimi değiştirirseniz alt seçimleri yeniden yapın.</p>
@if (Model.Options.Count == 0) { <p class="empty-state">Şu anda randevu alınabilecek hizmet bulunmuyor. Lütfen daha sonra tekrar deneyin.</p> }
<form method="get" asp-action="Book" aria-describedby="selection-help" data-booking-selection>
<p data-booking-status role="status" aria-live="polite"></p>
<input type="hidden" name="Date" value="@Model.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"/>
<div class="booking-fields">
@{ var candidates = Model.Options; var fields = new[] { ("ClinicId", "Klinik", Model.ClinicId), ("BranchId", "Şube", Model.BranchId), ("DepartmentId", "Bölüm", Model.DepartmentId), ("DoctorId", "Doktor", Model.DoctorId), ("ServiceId", "Hizmet", Model.ServiceId) }; }
@for (var i = 0; i < fields.Length; i++)
{
    var field = fields[i];
    var choices = candidates.Select(x => i switch { 0 => (x.ClinicId, x.Clinic), 1 => (x.BranchId, x.Branch), 2 => (x.DepartmentId, x.Department), 3 => (x.DoctorId, x.Doctor), _ => (x.ServiceId, $"{x.Service} - {x.Duration.TotalMinutes} dakika - {x.Price.ToString("N2", tr)} TRY") }).Distinct().OrderBy(x => x.Item2, StringComparer.Create(tr, false)).ToArray();
    <div><label for="@field.Item1">@field.Item2</label><select id="@field.Item1" name="@field.Item1" disabled="@(choices.Length == 0)"><option value="@Guid.Empty">@(choices.Length == 0 ? "Önce üst seçimi tamamlayın" : "Seçin")</option>
    @foreach (var choice in choices) { <option value="@choice.Item1" selected="@(choice.Item1 == field.Item3)">@choice.Item2</option> }
    </select></div>
    candidates = candidates.Where(x => (i switch { 0 => x.ClinicId, 1 => x.BranchId, 2 => x.DepartmentId, 3 => x.DoctorId, _ => x.ServiceId }) == field.Item3).ToArray();
}
</div>
<div class="booking-actions"><button name="Stage" value="1" class="button-secondary" data-booking-update>Seçenekleri güncelle</button><button name="Stage" value="2" data-booking-continue>Tarih ve saate devam et</button></div>
</form></section>
<script src="~/js/booking.js" asp-append-version="true" defer></script>
}
else
{
var selected = Model.Selection!;
<section class="card"><h2>@(Model.Stage == 2 ? "2. Tarih ve saat seçin" : "3. Talebinizi kontrol edin")</h2>
<p>Ücret: @selected.Price.ToString("N2", tr) TRY</p>
<dl class="booking-summary">
<div><dt>Klinik</dt><dd>@selected.Clinic</dd></div><div><dt>Şube</dt><dd>@selected.Branch</dd></div><div><dt>Bölüm</dt><dd>@selected.Department</dd></div><div><dt>Doktor</dt><dd>@selected.Doctor</dd></div><div><dt>Hizmet</dt><dd>@selected.Service</dd></div><div><dt>Süre</dt><dd>@selected.Duration.TotalMinutes.ToString(tr) dakika</dd></div>
@if (Model.Stage == 3) { <div><dt>Tarih</dt><dd>@Model.LocalStart!.Value.ToString("dd MMMM yyyy, dddd", tr)</dd></div><div><dt>Saat</dt><dd>@Model.LocalStart!.Value.ToString("HH:mm", tr)</dd></div> }
</dl>
<form asp-action="Book" method="get">
<input type="hidden" name="ClinicId" value="@Model.ClinicId"/><input type="hidden" name="BranchId" value="@Model.BranchId"/><input type="hidden" name="DepartmentId" value="@Model.DepartmentId"/><input type="hidden" name="DoctorId" value="@Model.DoctorId"/><input type="hidden" name="ServiceId" value="@Model.ServiceId"/>
@if (Model.Stage == 2)
{
<label for="booking-date">Randevu tarihi</label><input id="booking-date" name="Date" type="date" required value="@Model.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"/>
<button name="Stage" value="2" class="button-secondary">Uygun saatleri göster</button>
<p>@Model.Date.ToString("dd MMMM yyyy, dddd", tr)</p>
@if (Model.Slots.Count == 0) { <p class="empty-state" role="status">@(selected.ClosedDays?.Contains(Model.Date.DayOfWeek) == true ? "Şube bu tarihte kapalı. Başka bir tarih seçin." : "Bu tarihte uygun saat bulunmuyor. Başka bir tarih seçin.")</p> }
@if (Model.TimeCards.Count > 0) {
<fieldset class="booking-times"><legend>Randevu saatleri: uygun bir saat seçin</legend><div class="booking-slot-grid">
@foreach (var card in Model.TimeCards) {
    <label class="booking-slot @(card.IsPast ? "booking-slot-past" : null)"><input type="radio" name="LocalStart" value="@card.LocalStart.ToString("yyyy-MM-ddTHH:mm:ss", CultureInfo.InvariantCulture)" disabled="@card.IsPast" checked="@(!card.IsPast && card.LocalStart == Model.LocalStart)"/><span>@card.LocalStart.ToString("HH:mm", tr)@if (card.IsPast) { <small class="booking-slot-note">Geçmiş saat</small> }</span></label>
}
</div></fieldset>
}
@if (Model.Slots.Count > 0) { <button name="Stage" value="3">Talep özetini gör</button> }
}
else
{
<input type="hidden" name="Date" value="@Model.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"/>
<input type="hidden" name="LocalStart" value="@Model.LocalStart!.Value.ToString("yyyy-MM-ddTHH:mm:ss", CultureInfo.InvariantCulture)"/>
@Html.AntiForgeryToken()
<button type="submit" formmethod="post">Randevu talebini gönder</button>
<button name="Stage" value="2" class="button-secondary">Tarih ve saati değiştir</button>
}
<button name="Stage" value="1" class="button-secondary" formnovalidate>Hizmet seçimini değiştir</button>
</form></section>
}
