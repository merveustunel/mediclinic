@model MediClinic.Application.AppointmentSummary
@using MediClinic.Domain
@{ var staff = ViewContext.RouteData.Values["controller"]?.ToString() == "StaffAppointments"; }
<h1>Randevu</h1>
<p class="alert" role="status">@TempData["Message"]</p>
<dl>
    <dt>Hizmet</dt><dd>@Model.Service</dd><dt>Doktor</dt><dd>@Model.Doctor</dd><dt>Şube</dt><dd>@Model.Branch</dd>
    <dt>Saat (Europe/Istanbul)</dt><dd>@MediClinic.Application.Scheduling.Local(Model.StartsAt).ToString("yyyy-MM-dd HH:mm") – @MediClinic.Application.Scheduling.Local(Model.EndsAt).ToString("yyyy-MM-dd HH:mm")</dd>
    <dt>Randevu süresi</dt><dd>@((Model.EndsAt - Model.StartsAt).TotalMinutes) dakika</dd>
    <dt>Durum</dt><dd><partial name="_StatusBadge" model="Model.Status" /></dd><dt>Karar gerekçesi</dt><dd>@Model.Reason</dd>
</dl>
@if (!staff && Model.Status is AppointmentStatus.Pending or AppointmentStatus.Confirmed)
{
    <form asp-action="Cancel" method="post">
        <input type="hidden" name="Id" value="@Model.Id" />
        <label for="reason">İptal gerekçesi</label><textarea id="reason" name="Reason" required maxlength="2000"></textarea>
        <button type="submit">Randevuyu iptal et</button>
    </form>
}
@if (staff && Model.Status is AppointmentStatus.Pending or AppointmentStatus.Confirmed)
{
    <form asp-action="Review" method="post">
        <input type="hidden" name="Id" value="@Model.Id" />
        <label for="reason">Gerekçe (ret için zorunlu)</label><textarea id="reason" name="Reason" maxlength="2000"></textarea>
        @if (Model.Status == AppointmentStatus.Pending)
        { <button name="Action" value="Confirm">Onayla</button><button name="Action" value="Reject">Reddet</button> }
        else { <button name="Action" value="Complete">Tamamla</button> }
    </form>
}
<a asp-action="Index">Randevulara dön</a>
