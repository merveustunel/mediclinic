@model MediClinic.Web.Models.ClinicManagementModel
@{ ViewData["Title"] = "Kurum yönetimi"; string[] days = ["Pazar", "Pazartesi", "Salı", "Çarşamba", "Perşembe", "Cuma", "Cumartesi"]; }
<h1>Kurum yönetimi</h1>
@if (TempData["ManagementSuccess"] is string success) { <p role="status">@success</p> }
@if (TempData["ManagementError"] is string error) { <p role="alert">@error</p> }
@if (Model.Clinics.Count == 0) { <p>Yetkili olduğunuz klinik bulunmuyor. Klinik yetkisi için sistem sorumlusuna başvurunuz.</p> }
else { <a asp-action="Edit" asp-route-kind="Clinic">Klinik oluştur</a> }
<form method="get" class="filter-form">
<label for="clinicId">Klinik</label><select id="clinicId" name="clinicId"><option value="">Tüm klinikler</option>@foreach(var c in Model.Clinics) { <option value="@c.Id" selected="@(c.Id == Model.ClinicId)">@c.Name</option> }</select>
<label for="branchId">Şube</label><select id="branchId" name="branchId"><option value="">Tüm şubeler</option>@foreach(var b in Model.Clinics.SelectMany(c => c.Branches).Where(b => !Model.ClinicId.HasValue || b.ClinicId == Model.ClinicId)) { <option value="@b.Id" selected="@(b.Id == Model.BranchId)">@b.Name</option> }</select>
<label for="departmentId">Bölüm</label><select id="departmentId" name="departmentId"><option value="">Tüm bölümler</option>@foreach(var d in Model.Clinics.SelectMany(c => c.Branches).Where(b => (!Model.ClinicId.HasValue || b.ClinicId == Model.ClinicId) && (!Model.BranchId.HasValue || b.Id == Model.BranchId)).SelectMany(b => b.Departments)) { <option value="@d.Id" selected="@(d.Id == Model.DepartmentId)">@d.Name</option> }</select>
<button type="submit">Filtrele</button><a asp-action="Index">Temizle</a>
</form>
@foreach (var clinic in Model.Clinics.Where(c => !Model.ClinicId.HasValue || c.Id == Model.ClinicId)) {
<section class="management-section"><h2>@clinic.Name</h2>
<a asp-action="Edit" asp-route-kind="Clinic" asp-route-id="@clinic.Id">Kliniği düzenle</a> &middot; <a asp-action="Edit" asp-route-kind="Branch" asp-route-parentId="@clinic.Id">Şube oluştur</a>
@if (clinic.Branches.Count == 0) { <p>Henüz Şube yok.</p> }
@foreach (var branch in clinic.Branches.Where(b => !Model.BranchId.HasValue || b.Id == Model.BranchId)) {
<section class="management-section"><h3>@branch.Name</h3><p>@branch.Address</p>
<a asp-action="Edit" asp-route-kind="Branch" asp-route-id="@branch.Id">Şubeyi düzenle</a> &middot; <a asp-action="Edit" asp-route-kind="Department" asp-route-parentId="@branch.Id">Bölüm oluştur</a>
@if (branch.Departments.Count == 0) { <p>Henüz bölüm yok.</p> }
@foreach(var department in branch.Departments.Where(d => !Model.DepartmentId.HasValue || d.Id == Model.DepartmentId)) {
<h4>@department.Name</h4>
<p><a asp-action="Edit" asp-route-kind="Department" asp-route-id="@department.Id">Bölümü düzenle</a> · <a asp-action="Edit" asp-route-kind="Service" asp-route-parentId="@department.Id">Hizmet oluştur</a></p>
@if (department.Services.Count == 0) { <p>Henüz hizmet yok.</p> }
<ul>@foreach(var service in department.Services) { <li>@service.Name &middot; @service.Duration.TotalMinutes dakika &middot; @service.Price.ToString("N2") TRY <a asp-action="Edit" asp-route-kind="Service" asp-route-id="@service.Id">Hizmeti düzenle</a></li> }</ul>
}
<details><summary>Şube çalışma saatleri</summary><p>Türkiye yerel saati. Tanımlanmamış günler için henüz çalışma saati kaydı yoktur. Randevu uygunluğuna bağlantı M12 kapsamında tamamlanacaktır.</p>
@for(var day = 0; day < 7; day++) {
var hours = Model.Hours.SingleOrDefault(h => h.BranchId == branch.Id && (int)h.Day == day);
<form asp-action="Hours" method="post" class="hours-form">
<input type="hidden" name="branchId" value="@branch.Id" /><input type="hidden" name="day" value="@day" />
<strong>@days[day]</strong><span>@(hours is null ? "Tanımlanmadı" : hours.Closed ? "Kapalı" : "Açık")</span>
<label>Kapalı <input type="checkbox" name="closed" value="true" checked="@(hours?.Closed == true)" /></label>
<label>Açılış <input type="time" name="opens" value="@(hours?.Opens?.ToString("HH:mm"))" /></label>
<label>Kapanış <input type="time" name="closes" value="@(hours?.Closes?.ToString("HH:mm"))" /></label><button type="submit">Kaydet</button>
</form>
}
</details></section>
}
</section>
}
