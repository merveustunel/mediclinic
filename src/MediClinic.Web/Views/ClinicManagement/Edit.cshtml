@model MediClinic.Web.Models.CatalogEditModel
@{ ViewData["Title"] = "Kurum bilgileri"; }
<h1>Kurum bilgileri</h1>
<form asp-action="Edit" method="post" class="form-stack">
    <div asp-validation-summary="All" role="alert"></div>
    <input asp-for="Kind" type="hidden" /><input asp-for="Id" type="hidden" /><input asp-for="ParentId" type="hidden" />
    <label asp-for="Name"></label><input asp-for="Name" /><span asp-validation-for="Name"></span>
    @if (Model.Kind == "Branch") { <label asp-for="Address"></label><input asp-for="Address" /><span asp-validation-for="Address"></span> }
    @if (Model.Kind == "Service") {
        <label asp-for="DurationMinutes"></label><input asp-for="DurationMinutes" type="number" min="1" max="1440" /><span asp-validation-for="DurationMinutes"></span>
        <label for="Price">Ücret (TL)</label><input id="Price" name="Price" value="@Model.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)" type="number" min="0" max="999999999.99" step="0.01" /><span asp-validation-for="Price"></span>
    }
    <button type="submit">Kaydet</button><a asp-action="Index">Listeye dön</a>
</form>
