@model MediClinic.Web.Models.AvailabilityListModel
@using MediClinic.Application
@inject TimeProvider Clock
@{ ViewData["Title"] = "Doktor uygunluğu"; }
<h1>@Model.Doctor.FullName — Uygunluk</h1>
<p>Tüm saatler Europe/Istanbul saat dilimindedir.</p>
@if (TempData["EmployeeSuccess"] is string success) { <p role="status">@success</p> }
@if (TempData["EmployeeError"] is string error) { <p role="alert">@error</p> }
<form method="get" class="filter-form"><input type="hidden" name="doctorId" value="@Model.Doctor.Id" />
<label for="date">Tarih</label><input id="date" name="date" type="date" value="@(Model.Date?.ToString("yyyy-MM-dd"))" /><button type="submit">Filtrele</button>
<a asp-action="Availability" asp-route-doctorId="@Model.Doctor.Id">Tüm tarihler</a></form>
<a class="button" asp-action="Interval" asp-route-doctorId="@Model.Doctor.Id">Uygunluk ekle</a>
<div class="table-scroll"><table><caption>Uygunluk aralıkları</caption><thead><tr><th scope="col">Başlangıç</th><th scope="col">Bitiş</th><th scope="col">İşlemler</th></tr></thead><tbody>
@foreach (var interval in Model.Intervals)
{
    <tr><td>@Scheduling.Local(interval.StartsAt).ToString("dd.MM.yyyy HH:mm")</td><td>@Scheduling.Local(interval.EndsAt).ToString("dd.MM.yyyy HH:mm")</td><td>
    @if (interval.StartsAt > Clock.GetUtcNow())
    {
        <a asp-action="Interval" asp-route-doctorId="@Model.Doctor.Id" asp-route-id="@interval.Id">Düzenle</a>
        <form asp-action="RemoveInterval" method="post"><input type="hidden" name="doctorId" value="@Model.Doctor.Id" /><input type="hidden" name="id" value="@interval.Id" /><button type="submit">Güvenliyse sil</button></form>
    }
    else { <span>Geçmiş / başlamış kayıt</span> }</td></tr>
}
</tbody></table></div><a asp-action="Index">Çalışan listesine dön</a>
