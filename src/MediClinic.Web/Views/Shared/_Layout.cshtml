<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MediClinic</title>
</head>
<body>
    <header><a asp-controller="Home" asp-action="Index">MediClinic</a></header>
    <nav aria-label="Account">
    @if (User.Identity?.IsAuthenticated == true)
    {
        @if (User.IsInRole("Patient")) { <a asp-controller="Appointments" asp-action="Index">My appointments</a> }
        @if (User.IsInRole("Staff")) { <a asp-controller="StaffAppointments" asp-action="Index">Review appointments</a> }
        @foreach (var role in MediClinic.Infrastructure.Identity.AuthRoles.All)
        {
            if (User.IsInRole(role)) { <a asp-controller="Dashboard" asp-action="@role">@role dashboard</a> }
        }
        <form asp-controller="Account" asp-action="Logout" method="post"><button type="submit">Sign out</button></form>
    }
    else
    {
        <a asp-controller="Account" asp-action="Register">Register</a>
        <a asp-controller="Account" asp-action="Login">Sign in</a>
    }
    </nav>
    <main>@RenderBody()</main>
</body>
</html>
