@model MediClinic.Domain.AppointmentStatus
@{
    var (style, label) = Model switch
    {
        MediClinic.Domain.AppointmentStatus.Pending => ("pending", Ui.Text("Beklemede")),
        MediClinic.Domain.AppointmentStatus.Confirmed => ("confirmed", Ui.Text("Onaylandı")),
        MediClinic.Domain.AppointmentStatus.Completed => ("completed", Ui.Text("Tamamlandı")),
        MediClinic.Domain.AppointmentStatus.Cancelled => ("cancelled", Ui.Text("İptal edildi")),
        MediClinic.Domain.AppointmentStatus.Rejected => ("rejected", Ui.Text("Reddedildi")),
        _ => ("unknown", Ui.Text("Bilinmeyen durum"))
    };
}
<span class="status-badge status-@style" data-status="@Model">@label</span>
