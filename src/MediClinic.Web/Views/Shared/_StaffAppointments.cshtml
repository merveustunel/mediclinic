@model IReadOnlyList<MediClinic.Application.StaffDashboardAppointment>
@using MediClinic.Application
@using System.Globalization
<ul class="staff-appointment-list">
@foreach (var item in Model)
{
    <li>
        <div><strong data-user-content>@item.Patient</strong><p>@item.Service · @item.Doctor</p><small data-user-content>@item.Branch</small></div>
        <div><time datetime="@item.StartsAt.ToString("O")">@Scheduling.Local(item.StartsAt).ToString("dd MMMM yyyy, HH:mm", CultureInfo.CurrentCulture)</time><p><partial name="_StatusBadge" model="item.Status" /></p></div>

        <a class="button button-secondary" asp-controller="@(ViewData["ClinicAdminDashboard"] is true ? "AdminAppointments" : "StaffAppointments")" asp-action="Details" asp-route-id="@item.Id" aria-label="@(Ui.Format("{0} randevu detayını görüntüle", item.Patient))">@Ui.Text("Detayları incele")</a>
    </li>
}
</ul>
