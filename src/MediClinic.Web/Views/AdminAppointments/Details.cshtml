@model StaffAppointmentDetailsModel
@using MediClinic.Application
@using MediClinic.Domain
@using MediClinic.Infrastructure.Identity
@using System.Globalization
@{ var item = Model.Item.Appointment; var culture = CultureInfo.CurrentCulture; ViewData["Title"] = Ui.Text("Randevu detayı"); }
<header class="appointments-heading"><div><p class="eyebrow">@Ui.Text("RANDEVU YÖNETİMİ")</p><h1>@Ui.Text("Randevu detayı")</h1></div><partial name="_StatusBadge" model="item.Status" /></header>
@if (TempData["Message"] is string message) { <p class="alert" role="status">@message</p> }
<div asp-validation-summary="All" role="alert"></div>
<p>@Ui.Text("Klinik:") <span data-user-content>@item.Clinic</span> - @Ui.Text("Bölüm:") <span data-user-content>@item.Department</span></p>
<p>@Ui.Text("Ücret:") @if (item.Price.HasValue) { <span data-money="@item.Price.Value.ToString(CultureInfo.InvariantCulture)">@Ui.Money(item.Price.Value)</span> } else { @Ui.Text("Bilinmiyor (eski kayıt)") }</p>
<dl class="booking-summary staff-details">
    <div><dt>@Ui.Text("Hasta")</dt><dd data-user-content>@Model.Item.Patient</dd></div><div><dt>@Ui.Text("Doktor")</dt><dd data-user-content>@item.Doctor</dd></div>
    <div><dt>@Ui.Text("Hizmet")</dt><dd data-user-content>@item.Service</dd></div><div><dt>@Ui.Text("Şube")</dt><dd data-user-content>@item.Branch</dd></div>
    <div><dt>@Ui.Text("Tarih ve başlangıç saati")</dt><dd><time datetime="@item.StartsAt.ToString("O")">@Scheduling.Local(item.StartsAt).ToString("dd MMMM yyyy, HH:mm", culture)</time></dd></div>
    <div><dt>@Ui.Text("Bitiş saati")</dt><dd><time datetime="@item.EndsAt.ToString("O")">@Scheduling.Local(item.EndsAt).ToString("dd MMMM yyyy, HH:mm", culture)</time></dd></div>
    <div><dt>@Ui.Text("Süre")</dt><dd>@((item.EndsAt-item.StartsAt).TotalMinutes) @Ui.Text("dakika")</dd></div>
    @if (!string.IsNullOrEmpty(item.Reason)) { <div><dt>@Ui.Text("Karar gerekçesi")</dt><dd data-user-content class="staff-reason">@item.Reason</dd></div> }
</dl>
<p class="field-hint">@Ui.Text("Saatler İstanbul saatine göredir.")</p>
@if (User.IsInRole(AuthRoles.ClinicAdmin))
{
    @if (item.Status == AppointmentStatus.Pending)
    {
        <section class="staff-actions"><h2>@Ui.Text("Talebi değerlendir")</h2>
        <form asp-action="Review" method="post"><input type="hidden" name="Id" value="@item.Id" /><button name="Action" value="Confirm">@Ui.Text("Randevuyu onayla")</button></form>
        <form asp-action="Review" method="post"><input type="hidden" name="Id" value="@item.Id" /><label for="reason">@Ui.Text("Ret gerekçesi (zorunlu)")</label><textarea id="reason" name="Reason" required maxlength="2000" aria-describedby="reason-hint">@Model.Reason</textarea><p class="field-hint" id="reason-hint">@Ui.Text("En fazla 2000 karakter. Gerekçe hasta tarafından da görüntülenebilir.")</p><button class="button-danger" name="Action" value="Reject">@Ui.Text("Randevuyu reddet")</button></form></section>
    }

}
else { <p class="field-hint">@Ui.Text("Bu sayfaya yalnızca görüntüleme erişiminiz bulunmaktadır.")</p> }
<p><a class="button button-secondary" asp-action="Index">@Ui.Text("Randevu listesine dön")</a></p>
