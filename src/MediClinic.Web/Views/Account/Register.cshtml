@model MediClinic.Web.Models.RegisterModel
<h1>Hasta kaydı</h1>
<form asp-action="Register" method="post">
<div asp-validation-summary="All"></div>
<label asp-for="Email">E-posta</label><input asp-for="Email" autocomplete="email" />
<label asp-for="Password">Parola</label><input asp-for="Password" autocomplete="new-password" />
<label asp-for="FirstName">Ad</label><input asp-for="FirstName" />
<label asp-for="LastName">Soyad</label><input asp-for="LastName" />
<label asp-for="DateOfBirth">Doğum tarihi</label><input asp-for="DateOfBirth" />
<p>Büyük harf, küçük harf, rakam ve simge içeren en az 12 karakter kullanın.</p>
<button type="submit">Kayıt ol</button>
</form>
