@model MediClinic.Web.Models.LoginModel
@{ ViewData["Title"] = Ui.Text("Giriş yap"); }
<section class="auth-panel" aria-labelledby="auth-title">
    <p class="eyebrow">@Ui.Text("HESABINIZA ERİŞİN")</p>
    <h1 id="auth-title">@Ui.Text("Giriş yap")</h1>
    <p class="auth-intro">@Ui.Text("MediClinic hesabınızla size özel panelinize ulaşın.")</p>
    <form asp-action="Login" method="post" class="auth-form">
        <div asp-validation-summary="All" role="alert" aria-label="@Ui.Text("Giriş hataları")"><p>@Ui.Text("İşlem tamamlanamadı. Aşağıdaki bilgileri kontrol edin.")</p></div>
        <div class="auth-field">
            <label asp-for="Email">@Ui.Text("E-posta")</label>
            <input asp-for="Email" autocomplete="username" aria-describedby="Email-error" aria-invalid="@(ViewData.ModelState["Email"]?.Errors.Count > 0 ? "true" : null)" />
            <span asp-validation-for="Email" id="Email-error" class="field-error"></span>
        </div>
        <div class="auth-field">
            <label asp-for="Password">@Ui.Text("Parola")</label>
            <div class="password-control">
                <input asp-for="Password" autocomplete="current-password" aria-describedby="Password-error Password-hint" aria-invalid="@(ViewData.ModelState["Password"]?.Errors.Count > 0 ? "true" : null)" />
                <button type="button" class="button-secondary password-toggle" data-password-toggle="Password" aria-controls="Password" aria-pressed="false" hidden>@Ui.Text("Parolayı göster")</button>
            </div>
            <p id="Password-hint" class="field-hint">@Ui.Text("Parolanız büyük ve küçük harflere duyarlıdır.")</p>
            <span asp-validation-for="Password" id="Password-error" class="field-error"></span>
        </div>
        <button type="submit" class="auth-submit">@Ui.Text("Giriş yap")</button>
    </form>
    <p class="auth-footer">@Ui.Text("Henüz hesabınız yok mu?") <a asp-action="Register">@Ui.Text("Hasta kaydı oluşturun")</a></p>
</section>
