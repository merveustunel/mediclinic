@model MediClinic.Web.Models.LoginModel
<h1>Giriş yap</h1>
<form asp-action="Login" method="post">
<div asp-validation-summary="All"></div>
<label asp-for="Email">E-posta</label><input asp-for="Email" autocomplete="username" />
<label asp-for="Password">Parola</label><input asp-for="Password" autocomplete="current-password" />
<button type="submit">Giriş yap</button>
</form>
