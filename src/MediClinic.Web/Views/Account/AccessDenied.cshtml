@{ ViewData["Title"] = "Erişim engellendi"; }
<section class="auth-panel auth-result" aria-labelledby="auth-title">
    <span class="auth-mark" aria-hidden="true">!</span>
    <p class="eyebrow">ERİŞİM YETKİSİ GEREKİYOR</p>
    <h1 id="auth-title">Erişim engellendi</h1>
    <p class="auth-intro">Hesabınızın bu sayfaya erişim yetkisi bulunmuyor.</p>
    <p>Menüden hesabınıza açık sayfalara ulaşabilirsiniz.</p>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a class="button" asp-controller="Dashboard" asp-action="Index">Panelime dön</a>
    }
    else
    {
        <a class="button" asp-action="Login">Giriş yap</a>
    }
    <a class="auth-home" asp-controller="Home" asp-action="Index">Ana sayfaya dön</a>
</section>
